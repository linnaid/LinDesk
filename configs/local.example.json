{
  "service": {
    "name": "lindesk",
    "environment": "local",
    "http_addr": ":8080",
    "shutdown_timeout": "10s"
  },
  "database": {
    "driver": "postgres",
    "dsn": "postgres://lindesk:lindesk@localhost:5432/lindesk?sslmode=disable"
  },
  "refund": {
    "high_amount_approval_threshold": 50000
  }
}
